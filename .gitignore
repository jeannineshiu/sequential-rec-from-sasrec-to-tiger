# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version-lock

# Data (downloaded, not committed)
data/raw/
data/processed/
*.csv
*.dat
*.zip
*.gz

# MLflow. The canonical tracking DB IS committed: results/tables/master.md is
# generated from it by src/export_results.py, so without it a clone can read that
# table but cannot regenerate or verify it. Per-sandbox DBs from remote runs are
# not -- their runs are merged into mlflow.db by scripts/merge_daytona_results.py.
mlruns/
mlartifacts/
mlflow*.db
!mlflow.db

# Results: master.md and figures ARE committed deliverables (script-generated,
# referenced from README.md) -- only the large binary checkpoints are excluded.
results/checkpoints/

# Notebooks checkpoints
.ipynb_checkpoints/

# RecBole: regenerable atomic files, cached dataset objects, tensorboard logs
dataset/
saved/
log_tensorboard/

# Claude Code runtime state (not project content)
.claude/

# Personal notes (not part of the repo)
notes/

# OS
.DS_Store

# Editors
.vscode/
.idea/
.obsidian/

# Daytona launch/run logs (throwaway)
week4*.log
*_daytona_*.db

# RecBole logger output (regenerable)
log/
